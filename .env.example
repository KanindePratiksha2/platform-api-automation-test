# Environment Configuration for API Tests
# Copy this file to .env and update with your actual values

# Environment to run tests against (local, dev, sand, prod)
TEST_ENV=local

# API Base URLs for different environments
LOCAL_BASE_URL=http://localhost:3000
DEV_BASE_URL=https://api-dev.example.com
SAND_BASE_URL=https://vljvftar07.execute-api.us-west-2.amazonaws.com/sand
PROD_BASE_URL=https://api.example.com

# Authentication Token (JWT from iDempiere)
# Token must be obtained externally and set here
# Example: AUTH_TOKEN=eyJraWQiOiJpZGVtcGllcmUi...
AUTH_TOKEN=your-jwt-token-here

# Logging
LOG_LEVEL=info
DEBUG=false

# Test Configuration
TEST_TIMEOUT=30000
RETRY_ATTEMPTS=1
MAX_WORKERS=5

# Report Output
REPORT_DIR=./reports
