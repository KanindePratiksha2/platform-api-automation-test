# Environment Configuration for API Tests
# Copy this file to .env and update with your actual values

# Environment to run tests against (local, dev, sand, prod)
TEST_ENV=local

# API Base URLs for different environments
LOCAL_BASE_URL=http://localhost:3000
DEV_BASE_URL=https://api-dev.example.com
SAND_BASE_URL=https://api-sand.example.com
PROD_BASE_URL=https://api.example.com

# Authentication
# API Key for authenticated platform endpoints (REQUIRED)
API_KEY=your-api-key-here

# Authentication Token (JWT from iDempiere)
# Option 1: Use static token (set this if you have a token)
# Token must be obtained externally and set here
# Example: AUTH_TOKEN=eyJraWQiOiJpZGVtcGllcmUi...
AUTH_TOKEN=your-jwt-token-here

# Option 2: Trek Login Configuration (used if AUTH_TOKEN is not set)
# All Trek variables below are REQUIRED if using Trek login
# Base URL for Trek authentication API (should end with /api/v1)
TREK_BASE_URL=https://your-trek-host.com/api/v1

# Trek credentials (REQUIRED)
TREK_USERNAME=your-email@theprovenancechain.com
TREK_PASSWORD=your-password

# Trek parameters (REQUIRED)
TREK_CLIENT_ID=1000001
TREK_ROLE_ID=PCN-Test User
TREK_ORGANIZATION_ID=1000001
TREK_WAREHOUSE_ID=1000001

# Trek language (optional, defaults to en_US if not set)
TREK_LANGUAGE=en_US

# Logging
LOG_LEVEL=info
DEBUG=false

# Test Configuration
TEST_TIMEOUT=30000
RETRY_ATTEMPTS=1
MAX_WORKERS=5

# Report Output
REPORT_DIR=./reports
